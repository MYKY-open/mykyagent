run_model() {

    [ ! -f "$MODEL_LIST_FILE" ] && { echo "No models!"; exit 1; }
    local selected=$(cat "$MODEL_LIST_FILE" | awk -F'|' '{printf "%2d) %-20s [%s]\n", NR, $1, $3}' | fzf_with_usage models --prompt="Select model > ")
    [ -z "$selected" ] && return
    
    local index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
    IFS='|' read -r selected_alias selected_path selected_custom <<< "$(sed "${index}q;d" "$MODEL_LIST_FILE")"
    final_args="$DEFAULT_MODEL_ARGS $selected_custom ${EXTRA_ARGS[*]}"

    # Setup model-specific speculative decoding lookup cache
    local safe_alias=$(echo "$selected_alias" | tr -dc 'a-zA-Z0-9_-')
    local model_cache="$BASE_DIR/cache/${safe_alias}.cache"
    touch "$model_cache"
    SERVER_ARGS="$SERVER_ARGS -lcd $model_cache"

    if [ "$MAX_VRAM_MB" -gt 0 ] && [ -f "$selected_path" ]; then
        echo -e "\n[Auto-NGL] Calculating optimal VRAM offload..."
        
        local NGL_CACHE_FILE="$CONFIG_DIR/ngl_cache.txt"
        [ ! -f "$NGL_CACHE_FILE" ] && touch "$NGL_CACHE_FILE"
        
        # Cache format: path|layers|avg_block_mb|non_block_mb
        local cache_hit=$(awk -F'|' -v path="$selected_path" '$1 == path {print $2"|"$3"|"$4; exit}' "$NGL_CACHE_FILE")
        local layers avg_block_mb non_block_mb

        if [ -n "$cache_hit" ]; then
            echo "[Auto-NGL] Fast-loaded layer sizes from cache!"
            IFS='|' read -r layers avg_block_mb non_block_mb <<< "$cache_hit"
        else
            local gguf_out
            gguf_out=$(uv run -q --with gguf python -c "
import gguf, re
r = gguf.GGUFReader('$selected_path')
block_count = next(v for k,v in r.fields.items() if 'block_count' in k).parts[-1].tolist()[0]
non_block = 0
blocks = {}
for t in r.tensors:
    m = re.match(r'blk\.(\d+)\.', t.name)
    if m:
        l = int(m.group(1))
        blocks[l] = blocks.get(l, 0) + t.n_bytes
    else:
        non_block += t.n_bytes
avg = sum(blocks.values()) / len(blocks) if blocks else 0
print(f'{int(block_count)}|{avg/1024/1024:.2f}|{non_block/1024/1024:.2f}')
" 2>/dev/null)
            if [ -n "$gguf_out" ]; then
                IFS='|' read -r layers avg_block_mb non_block_mb <<< "$gguf_out"
                sed -i "\|^$selected_path|d" "$NGL_CACHE_FILE" 2>/dev/null || true
                echo "$selected_path|$layers|$avg_block_mb|$non_block_mb" >> "$NGL_CACHE_FILE"
            fi
        fi

        if [ -n "$layers" ] && [ "$layers" -gt 0 ]; then
            # Reserve ~512 MB for KV cache and compute scratch buffers
            local compute_reserve_mb=512
            local avg_block_int=$(echo "$avg_block_mb" | cut -d. -f1)
            local non_block_int=$(echo "$non_block_mb" | cut -d. -f1)

            local available_vram=$((MAX_VRAM_MB - non_block_int - compute_reserve_mb))
            [ "$available_vram" -lt 0 ] && available_vram=0

            if [ "$avg_block_int" -gt 0 ]; then
                local calculated_ngl=$((available_vram / avg_block_int))
                [ "$calculated_ngl" -gt "$layers" ] && calculated_ngl=$layers
                echo "[Auto-NGL] Model: ${layers} layers, ~${avg_block_mb}MB/layer, ${non_block_mb}MB overhead"
                echo "[Auto-NGL] Budget: ${MAX_VRAM_MB}MB VRAM - ${non_block_int}MB overhead - ${compute_reserve_mb}MB reserve = ${available_vram}MB for layers"
                echo "[Auto-NGL] Setting -ngl to $calculated_ngl"

                final_args=$(echo "$final_args" | sed -E 's/-ngl [0-9]+//g')
                final_args="-ngl $calculated_ngl $final_args"
            fi
        else
            echo "[Auto-NGL] Failed to read layer count from GGUF. Falling back to default."
        fi
    fi

    local mode_menu="1) CLI\n2) Server\n3) Public\n4) Silly\n5) OpenCode\n6) Odysseus\n7) Codehamr\n8) Hermes\n9) Pi\n10) Little-coder\n11) Deepseek-harness\n12) MykyAgent"
    local mode=$(echo -e "$mode_menu" | fzf_with_usage modes --prompt="Mode > " | awk '{print $1}' | tr -d ')')
    [ -z "$mode" ] && return
    
    case $mode in
        1) select_prompt
           [ ! -x "$LLAMA_DIR/build/bin/llama-cli" ] && { echo "Error: llama-cli not compiled!"; return; }
           run_pinned "$LLAMA_DIR/build/bin/llama-cli" -m "$selected_path" ${selected_prompt:+--system-prompt-file "$selected_prompt"} --no-display-prompt -cnv $final_args ;;
        2) [ ! -x "$LLAMA_DIR/build/bin/llama-server" ] && { echo "Error: llama-server not compiled!"; return; }
           # Prepend server-mode flags now that we know the mode
           final_args="$SERVER_ARGS $final_args"
           run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" $final_args ;;
        3) [ ! -x "$LLAMA_DIR/build/bin/llama-server" ] && { echo "Error: llama-server not compiled!"; return; }
           # Prepend server-mode flags now that we know the mode
           final_args="$SERVER_ARGS --api-key $API_KEY $final_args"
           local ips=$(ip -br addr show | awk '$1 != "lo" && $2 == "UP" {gsub(/\/[0-9]+/, "", $0); out="[" $1 "]"; for(i=3;i<=NF;i++) if($i !~ /^fe80:/) out=out " " $i; print out}' | paste -sd " | " -)
           echo "[Server] Public IPs: $ips"
           run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" $final_args --host 0.0.0.0 ;;
        4) launch_sillytavern ;;
        5) launch_opencode ;;
        6) launch_odysseus ;;
        7) launch_codehamr ;;
        8) launch_hermes ;;
        9) launch_pi ;;
        10) launch_littlecoder ;;
        11) launch_deepseek ;;
        12) launch_mykyagent ;;
        *) ;;
    esac
}

# =============================================================================
# Main Entry Point
# =============================================================================

# Extract -vram if present so we can override MAX_VRAM_MB dynamically
NEW_ARGS=()
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "-vram" || "$1" == "--vram" ]]; then
        MAX_VRAM_MB="$2"
        shift 2
    else
        NEW_ARGS+=("$1")
        shift
    fi
done
set -- "${NEW_ARGS[@]}"

# Set EXTRA_ARGS depending on whether the first argument was a script flag
case "$1" in
    -is|--installscr) EXTRA_ARGS=("${@:2}"); install_script ;;
    -b|--backend)     EXTRA_ARGS=("${@:2}"); switch_backend ;;
    -p|--patch)       EXTRA_ARGS=("${@:3}"); apply_patch "$2" ;;
    -i|--install)     EXTRA_ARGS=("${@:2}"); install_llm_core ;;
    -u|--upgrade)     EXTRA_ARGS=("${@:2}"); upgrade_llm_core ;;
    -e|--edit)        EXTRA_ARGS=("${@:2}"); edit_script ;;
    -sm|--scan-models) EXTRA_ARGS=("${@:2}"); scan_models ;;
    -s|--settings)    EXTRA_ARGS=("${@:2}"); configure_settings ;;
    -d|--delete)      EXTRA_ARGS=("${@:2}"); delete_model ;;
    -r|--run-silly)   EXTRA_ARGS=("${@:2}"); run_sillytavern_standalone ;;
    -dh|--run-deepseek) EXTRA_ARGS=("${@:3}"); run_deepseek_standalone "$2" ;;
    -oc|--run-opencode) EXTRA_ARGS=("${@:2}"); run_opencode_standalone ;;
    -ch|--run-codehamr) EXTRA_ARGS=("${@:2}"); run_codehamr_standalone ;;
    -he|--run-hermes) EXTRA_ARGS=("${@:3}"); run_hermes_standalone "$2" ;;
    -hs|--hermes-setup) EXTRA_ARGS=("${@:2}"); run_hermes_setup ;;
    -pi|--run-pi)     EXTRA_ARGS=("${@:3}"); run_pi_standalone "$2" ;;
    -lc|--run-littlecoder) EXTRA_ARGS=("${@:3}"); run_littlecoder_standalone "$2" ;;
    -ma|--run-mykyagent) EXTRA_ARGS=("${@:3}"); run_mykyagent_standalone "$2" ;;
    -o|--run-ooba)    EXTRA_ARGS=("${@:2}"); run_oobabooga ;;
    -O|--run-odys)    EXTRA_ARGS=("${@:2}"); run_odysseus_standalone ;;
    -h|--help)        EXTRA_ARGS=("${@:2}"); print_help ;;
    -Re|--reset)      EXTRA_ARGS=("${@:2}"); reset_llm ;;
    -C|--configure)   EXTRA_ARGS=("${@:2}"); configure_llm ;;
    -m|--modellistedit) EXTRA_ARGS=("${@:2}"); $EDITOR "$MODEL_LIST_FILE" ;;
    -ps|--scan-prompts) EXTRA_ARGS=("${@:2}"); scan_prompts ;;
    -pd|--delete-prompt) EXTRA_ARGS=("${@:2}"); delete_prompt ;;
    -pe|--edit-prompts) EXTRA_ARGS=("${@:2}"); $EDITOR "$PROMPT_LIST_FILE" ;;
    -c|--compile)     EXTRA_ARGS=("${@:2}"); compile_llm_core ;;
    *)                EXTRA_ARGS=("$@"); run_model ;;
esac
