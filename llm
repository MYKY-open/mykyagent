cleanup() {
    if [ -n "$llama_pid" ]; then
        echo -e "\n[LLM] Cleaning up server (PID: $llama_pid)..."
        kill -TERM -"$llama_pid" 2>/dev/null || kill "$llama_pid" 2>/dev/null || true
        for i in {1..10}; do
            if ! kill -0 "$llama_pid" 2>/dev/null; then break; fi
            sleep 0.5
        done
        kill -9 "$llama_pid" 2>/dev/null || true
    fi
}

trap cleanup EXIT SIGINT SIGTERM

ensure_repo() {
    local dir=$1
    local repo=$2
    if [ ! -d "$dir" ]; then
        echo "Cloning $repo into $dir..."
        git clone --depth 1 "$repo" "$dir"
    fi
}

run_pinned() {
    # Hard-pin the process to the first physical cores to prevent thread hopping
    if command -v taskset &> /dev/null; then
        local TASKSET_CMD=(taskset -c 0-$((PHYSICAL_CORES-1)))
        exec "${TASKSET_CMD[@]}" "$@"
    else
        exec "$@"
    fi
}

probe_remote_ctx() {
    local url="$1"
    local key="$2"
    local props_url="${url%/v1}/props"
    local server_ctx=$(curl -s --max-time 2 -H "Authorization: Bearer $key" "$props_url" | sed -n 's/.*"n_ctx"[[:space:]]*:[[:space:]]*\([0-9]\+\).*/\1/p' | head -n 1)
    if [ -n "$server_ctx" ] && [ "$server_ctx" -gt 0 ]; then
        export SELECTED_CTX="$server_ctx"
    fi
}

start_llama_server() {
    local port=${1:-8080}
    echo "Starting llama-server on port $port..."
    
    if [ ! -x "$LLAMA_DIR/build/bin/llama-server" ]; then
        echo "Error: llama-server binary not found!"
        echo "Please compile it first by running: llm -cl"
        exit 1
    fi
    
    local extra_args=()
    [ -n "$selected_alias" ] && extra_args=("--alias" "$selected_alias")
    
    run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" "${extra_args[@]}" $SERVER_ARGS $final_args --port "$port" > llama-server.log 2>&1 &
    llama_pid=$!
    
    echo -n "Waiting for server to be ready..."
    for i in {1..60}; do
        if curl -s "http://localhost:$port/health" | grep -q '{"status":"ok"}'; then
            echo " Ready!"
            break
        fi
        if ! kill -0 "$llama_pid" 2>/dev/null; then
            echo -e "\nServer crashed! Check llama-server.log"
            exit 1
        fi
        echo -n "."
        sleep 1
    done
    
    # Export common AI environment variables for downstream clients
    export OPENAI_API_BASE_URL="http://localhost:$port/v1"
    export OPENAI_API_BASE="http://localhost:$port/v1"
    export OPENAI_API_KEY="$API_KEY"
    
    probe_remote_ctx "http://localhost:$port/v1" "$API_KEY"
}

# =============================================================================
# Compiler & Build
# =============================================================================

setup_compiler() {
    export CC=gcc
    export CXX=g++

    OMP_FLAG="-fopenmp"

    CMAKE_COMPILER_ARGS=(
        -DCMAKE_C_COMPILER=gcc
        -DCMAKE_CXX_COMPILER=g++
        -DCMAKE_BUILD_TYPE=Release
    )

    if command -v ccache &> /dev/null; then
        echo "[COMPILER] ccache detected, enabling..."
        CMAKE_COMPILER_ARGS+=(-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
    fi

    LLAMA_CFLAGS="$BASE_CFLAGS $OMP_FLAG"
}

install_llm_core() {
    echo "Installing llama.cpp ($ACTIVE_BACKEND)..."
    ensure_repo "$LLAMA_DIR" "$LLAMA_REPO"
    cd "$LLAMA_DIR" || exit
    if [ "$FORCE_RESET" == "1" ]; then
        git reset --hard HEAD
        git clean -fd
    fi
    git pull
    git submodule update --init --recursive --depth 1
    setup_compiler
    run_cmake -B build "${CMAKE_COMPILER_ARGS[@]}" -DCMAKE_C_FLAGS="$LLAMA_CFLAGS" -DCMAKE_CXX_FLAGS="$LLAMA_CFLAGS" "${BUILDOPT[@]}"
    cmake --build build --config Release -j "$BUILD_THREADS"
    mkdir -p "$PROMPTS_DIR"
}

install_all() {
    install_llm_core
    install_script
    echo "Installation complete."
}

install_codehamr() {
    echo "Installing codehamr locally..."
    mkdir -p "$CODEHAMR_DIR"
    curl -sL "https://github.com/codehamr/codehamr/releases/latest/download/codehamr-linux-amd64" -o "$CODEHAMR_DIR/codehamr"
    chmod +x "$CODEHAMR_DIR/codehamr"
    echo "codehamr installed to $CODEHAMR_DIR/codehamr"
}

install_opencode() {
    echo "Installing OpenCode locally..."
    curl -fsSL https://opencode.ai/install | bash
}

compile_llm_core() {
    echo "Compiling llama.cpp ($ACTIVE_BACKEND)..."
    cd "$LLAMA_DIR" || exit
    git submodule update --init --recursive --depth 1
    setup_compiler
    run_cmake -B build "${CMAKE_COMPILER_ARGS[@]}" -DCMAKE_C_FLAGS="$LLAMA_CFLAGS" -DCMAKE_CXX_FLAGS="$LLAMA_CFLAGS" "${BUILDOPT[@]}"
    cmake --build build -j "$BUILD_THREADS"
}

compile_all() {
    compile_llm_core
    echo "Recompilation complete."
}

upgrade_llm_core() {
    echo "Upgrading llama.cpp ($ACTIVE_BACKEND)..."
    [ ! -d "$LLAMA_DIR" ] && { echo "llama.cpp not installed!"; exit 1; }
    cd "$LLAMA_DIR" || exit
    if [ "$FORCE_RESET" == "1" ]; then
        git reset --hard HEAD
        git clean -fd
        git pull
    else
        git pull --rebase --autostash
    fi
    git submodule update --init --recursive --depth 1
    compile_llm_core
    
    [ -d "$SILLYTAVERN_DIR" ] && (cd "$SILLYTAVERN_DIR" && git pull)
    [ -d "$DEEPSEEK_DIR" ] && (cd "$DEEPSEEK_DIR" && git pull)
    [ -d "$OOBABOOGA_DIR" ] && (cd "$OOBABOOGA_DIR" && git pull)
    [ -d "$ODYSSEUS_DIR" ] && (cd "$ODYSSEUS_DIR" && git pull)
    [ -x "$CODEHAMR_DIR/codehamr" ] && install_codehamr
    [ -x "$HOME/.opencode/bin/opencode" ] && install_opencode
    [ -d "$PI_DIR" ] && install_pi
    [ -d "$LITTLECODER_DIR" ] && install_littlecoder
}

upgrade_all() {
    upgrade_llm_core
}

configure_llm() {
    echo "Preparing llama.cpp ($ACTIVE_BACKEND) for configuration..."
    ensure_repo "$LLAMA_DIR" "$LLAMA_REPO"
    cd "$LLAMA_DIR" || exit
    git submodule update --init --recursive --depth 1
    setup_compiler
    if [ ! -f "build/CMakeCache.txt" ]; then
        run_cmake -B build "${CMAKE_COMPILER_ARGS[@]}" -DCMAKE_C_FLAGS="$LLAMA_CFLAGS" -DCMAKE_CXX_FLAGS="$LLAMA_CFLAGS" "${BUILDOPT[@]}"
    fi
    ccmake build
}

switch_backend() {
    local backend_menu="1) mainline (fastest model support, universal, slowest)\n2) ikllamacpp (slowest model support, fastest for cuda only)\n3) beellamacpp (good model support, universal, fast)"
    local selected=$(echo -e "$backend_menu" | fzf_with_usage backends --prompt="Select Backend > " | awk '{print $2}')
    [ -z "$selected" ] && return
    
    if [[ "$selected" =~ ^(mainline|ikllamacpp|beellamacpp)$ ]]; then
        echo "$selected" > "$ACTIVE_BACKEND_FILE"
        echo "Active backend set to: $selected"
    else
        echo "Invalid backend selected."
        return 1
    fi
}

reset_llm() {
    echo "Resetting LLM build directory..."
    rm -rf "$LLAMA_DIR/build"
}

reset_all() {
    reset_llm
    echo "Full reset complete."
}

edit_script() { $EDITOR "$SCRIPT_PATH"; }

configure_settings() {
    while true; do
        local w_desc="\e[97m"
        local w_res="\e[0m"
        local options=$(
            if [ "$S_MIROSTAT" == "0" ]; then
            printf "%-3s %-25s %-22s %b%s%b\n" "1)" "Temperature" "[$S_TEMP]" "$w_desc" "- Controls randomness (0 = greedy, higher = creative)" "$w_res"
            fi
            if [ "$S_MIROSTAT" == "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "2)" "Top-P" "[$S_TOP_P]" "$w_desc" "- Nucleus sampling (1.0 = off, lower = stricter)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "3)" "Top-K" "[$S_TOP_K]" "$w_desc" "- Limits to top K most likely tokens (0 = off)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "4)" "Min-P" "[$S_MIN_P]" "$w_desc" "- Drops tokens below fraction of top prob (0.0 = off)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "5)" "Typical" "[$S_TYPICAL]" "$w_desc" "- Locally typical sampling (1.0 = off, lower = strict)" "$w_res"
            fi
        printf "%-3s %-25s %-22s %b%s%b\n" "6)" "Mirostat" "[$S_MIROSTAT]" "$w_desc" "- Actively maintains a target entropy (0=off, 1/2=on)" "$w_res"
            if [ "$S_MIROSTAT" != "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "7)" "Mirostat LR" "[$S_MIROSTAT_LR]" "$w_desc" "- Learning rate for Mirostat (default 0.1)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "8)" "Mirostat ENT" "[$S_MIROSTAT_ENT]" "$w_desc" "- Target entropy (perplexity) for Mirostat (default 5.0)" "$w_res"
            fi
            if [ "$S_MIROSTAT" == "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "9)" "Presence Penalty" "[$S_PRESENCE]" "$w_desc" "- Penalizes based on presence (0.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "10)" "Frequency Penalty" "[$S_FREQUENCY]" "$w_desc" "- Penalizes based on frequency (0.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "11)" "Repeat Penalty" "[$S_PENALTY_REPEAT]" "$w_desc" "- Penalizes exact sequences (1.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "12)" "Penalty Last N" "[$S_PENALTY_LAST_N]" "$w_desc" "- Number of prev tokens to consider (-1 = ctx, 0 = off)" "$w_res"
            fi
        printf "%-3s %-25s %-22s %b%s%b\n" "13)" "Speculative Type" "[$S_SPEC_TYPE]" "$w_desc" "- Mechanism to guess future tokens (ngram, eagle)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "14)" "Speculative Draft Max" "[$S_SPEC_N_MAX]" "$w_desc" "- Maximum tokens to guess per step" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "15)" "Speculative Draft Min" "[$S_SPEC_N_MIN]" "$w_desc" "- Minimum tokens to guess per step" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "16)" "Speculative DM Control" "[$S_SPEC_DM]" "$w_desc" "- Adaptive control (e.g. 'profit') to optimize speed" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "17)" "Context Size (0=auto)" "[$S_CTX_SIZE]" "$w_desc" "- Maximum number of tokens the model can remember" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "18)" "Draft Model Path" "[$S_DRAFT_MODEL]" "$w_desc" "- External draft model file for speculation" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "S)" "Save & Exit" "" "" "" ""
        printf "%-3s %-25s %-22s %b%s%b\n" "R)" "Save & Run Model" "" "" "" ""
        )

        local choice=$(echo -e "$options" | fzf --ansi --prompt="Settings > " | awk '{print $1}' | tr -d ')')
        [ -z "$choice" ] && break

        case "$choice" in
            1) read -p "Enter new Temperature (current: $S_TEMP): " val; [ -n "$val" ] && S_TEMP="$val" ;;
            2) read -p "Enter new Top-P (current: $S_TOP_P): " val; [ -n "$val" ] && S_TOP_P="$val" ;;
            3) read -p "Enter new Top-K (current: $S_TOP_K): " val; [ -n "$val" ] && S_TOP_K="$val" ;;
            4) read -p "Enter new Min-P (current: $S_MIN_P): " val; [ -n "$val" ] && S_MIN_P="$val" ;;
            5) read -p "Enter new Typical (current: $S_TYPICAL): " val; [ -n "$val" ] && S_TYPICAL="$val" ;;
            6) 
                local val=$(echo -e "0\n1\n2" | fzf --prompt="Mirostat > ")
                [ -n "$val" ] && S_MIROSTAT="$val"
                ;;
            7) read -p "Enter new Mirostat LR (current: $S_MIROSTAT_LR): " val; [ -n "$val" ] && S_MIROSTAT_LR="$val" ;;
            8) read -p "Enter new Mirostat ENT (current: $S_MIROSTAT_ENT): " val; [ -n "$val" ] && S_MIROSTAT_ENT="$val" ;;
            9) read -p "Enter new Presence Penalty (current: $S_PRESENCE): " val; [ -n "$val" ] && S_PRESENCE="$val" ;;
            10) read -p "Enter new Frequency Penalty (current: $S_FREQUENCY): " val; [ -n "$val" ] && S_FREQUENCY="$val" ;;
            11) read -p "Enter new Repeat Penalty (current: $S_PENALTY_REPEAT): " val; [ -n "$val" ] && S_PENALTY_REPEAT="$val" ;;
            12) read -p "Enter new Penalty Last N (current: $S_PENALTY_LAST_N): " val; [ -n "$val" ] && S_PENALTY_LAST_N="$val" ;;
            13) 
                local val=$(echo -e "none\ndraft-simple\ndraft-eagle3\ndraft-dflash\ndraft-dspark\ndraft-mtp\nngram-cache\nngram-simple\nngram-map-k\nngram-map-k4v\nngram-mod" | fzf --prompt="Spec Type > ")
                [ -n "$val" ] && S_SPEC_TYPE="$val"
                ;;
            14) read -p "Enter new Speculative Draft Max (current: $S_SPEC_N_MAX): " val; [ -n "$val" ] && S_SPEC_N_MAX="$val" ;;
            15) read -p "Enter new Speculative Draft Min (current: $S_SPEC_N_MIN): " val; [ -n "$val" ] && S_SPEC_N_MIN="$val" ;;
            16) 
                local val=$(echo -e "off\nprofit" | fzf --prompt="DM Controller > ")
                [ -n "$val" ] && S_SPEC_DM="$val"
                ;;
            17) read -p "Enter new Context Size (current: $S_CTX_SIZE): " val; [ -n "$val" ] && S_CTX_SIZE="$val" ;;
            18) 
                local dm_src=$(echo -e "From Model List\nEnter Path\nDisable" | fzf --prompt="Draft Model Source > ")
                if [ "$dm_src" == "From Model List" ]; then
                    if [ ! -f "$MODEL_LIST_FILE" ]; then
                        echo "No models in list!"
                        sleep 1
                    else
                        local selected=$(cat "$MODEL_LIST_FILE" | awk -F'|' '{printf "%2d) %-20s [%s]\n", NR, $1, $3}' | fzf_with_usage draftmodels --prompt="Select Draft Model > ")
                        if [ -n "$selected" ]; then
                            local index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
                            IFS='|' read -r _ selected_path _ <<< "$(sed "${index}q;d" "$MODEL_LIST_FILE")"
                            S_DRAFT_MODEL="$selected_path"
                        fi
                    fi
                elif [ "$dm_src" == "Enter Path" ]; then
                    read -e -p "Enter path to draft model file: " val
                    [ -n "$val" ] && S_DRAFT_MODEL="$val"
                elif [ "$dm_src" == "Disable" ]; then
                    S_DRAFT_MODEL=""
                fi
                ;;
            S) 
                cat > "$SETTINGS_FILE" <<EOF
S_TEMP="$S_TEMP"
S_TOP_P="$S_TOP_P"
S_TOP_K="$S_TOP_K"
S_MIN_P="$S_MIN_P"
S_TFS="$S_TFS"
S_TYPICAL="$S_TYPICAL"
S_MIROSTAT="$S_MIROSTAT"
S_MIROSTAT_LR="$S_MIROSTAT_LR"
S_MIROSTAT_ENT="$S_MIROSTAT_ENT"
S_PRESENCE="$S_PRESENCE"
S_FREQUENCY="$S_FREQUENCY"
S_PENALTY_REPEAT="$S_PENALTY_REPEAT"
S_PENALTY_LAST_N="$S_PENALTY_LAST_N"
S_SPEC_TYPE="$S_SPEC_TYPE"
S_SPEC_N_MAX="$S_SPEC_N_MAX"
S_SPEC_N_MIN="$S_SPEC_N_MIN"
S_SPEC_DM="$S_SPEC_DM"
S_CTX_SIZE="$S_CTX_SIZE"
S_DRAFT_MODEL="$S_DRAFT_MODEL"
EOF
                echo "Settings saved to $SETTINGS_FILE"
                break
                ;;
            R)
                cat > "$SETTINGS_FILE" <<EOF
S_TEMP="$S_TEMP"
S_TOP_P="$S_TOP_P"
S_TOP_K="$S_TOP_K"
S_MIN_P="$S_MIN_P"
S_TFS="$S_TFS"
S_TYPICAL="$S_TYPICAL"
S_MIROSTAT="$S_MIROSTAT"
S_MIROSTAT_LR="$S_MIROSTAT_LR"
S_MIROSTAT_ENT="$S_MIROSTAT_ENT"
S_PRESENCE="$S_PRESENCE"
S_FREQUENCY="$S_FREQUENCY"
S_PENALTY_REPEAT="$S_PENALTY_REPEAT"
S_PENALTY_LAST_N="$S_PENALTY_LAST_N"
S_SPEC_TYPE="$S_SPEC_TYPE"
S_SPEC_N_MAX="$S_SPEC_N_MAX"
S_SPEC_N_MIN="$S_SPEC_N_MIN"
S_SPEC_DM="$S_SPEC_DM"
S_CTX_SIZE="$S_CTX_SIZE"
S_DRAFT_MODEL="$S_DRAFT_MODEL"
EOF
                echo "Settings saved. Launching model picker..."
                # Rebuild LLM_DEFAULTS dynamically before running
                if [ "$S_MIROSTAT" != "0" ]; then
                    LLM_DEFAULTS="--temp 1.0 "
                else
                    LLM_DEFAULTS="--temp $S_TEMP "
                fi
                LLM_DEFAULTS+="--top-p $S_TOP_P --top-k $S_TOP_K --min-p $S_MIN_P "
                LLM_DEFAULTS+="--typical $S_TYPICAL --mirostat $S_MIROSTAT --mirostat-lr $S_MIROSTAT_LR --mirostat-ent $S_MIROSTAT_ENT "
                LLM_DEFAULTS+="--presence-penalty $S_PRESENCE --frequency-penalty $S_FREQUENCY --repeat-penalty $S_PENALTY_REPEAT --repeat-last-n $S_PENALTY_LAST_N "
                [ "$S_SPEC_TYPE" != "none" ] && LLM_DEFAULTS+="--spec-type $S_SPEC_TYPE "
                [ "$S_SPEC_N_MAX" != "0" ] && LLM_DEFAULTS+="--spec-draft-n-max $S_SPEC_N_MAX --spec-draft-n-min $S_SPEC_N_MIN "
                [ "$S_SPEC_DM" != "off" ] && LLM_DEFAULTS+="--spec-dm-controller $S_SPEC_DM "
                if [ "$S_CTX_SIZE" != "0" ] && [ -n "$S_CTX_SIZE" ]; then
                    LLM_DEFAULTS+="-c $S_CTX_SIZE "
                fi
                if [ -n "$S_DRAFT_MODEL" ] && [ "$S_DRAFT_MODEL" != '""' ]; then
                    LLM_DEFAULTS+="-md $S_DRAFT_MODEL "
                fi
                # We need to re-apply it to the active backend args
                case "$ACTIVE_BACKEND" in
                    ikllamacpp) DEFAULT_MODEL_ARGS="-rtr --no-warmup -fa on -ctk q8_0 -ctv q8_0 --device none -t $PHYSICAL_CORES -tb $PHYSICAL_CORES -ub 1024 $LLM_DEFAULTS" ;;
                    beellamacpp) DEFAULT_MODEL_ARGS="--poll 0 --no-warmup -fa on -ctk q8_0 -ctv q8_0 --reasoning-loop-guard force-close -t $PHYSICAL_CORES -tb $PHYSICAL_CORES --cpu-strict 1 -ub 2048 $LLM_DEFAULTS" ;;
                    *) DEFAULT_MODEL_ARGS="--poll 0 --no-warmup -fa on -ctk q8_0 -ctv q8_0 -t $PHYSICAL_CORES -tb $PHYSICAL_CORES --cpu-strict 1 -ub 1024 $LLM_DEFAULTS" ;;
                esac
                run_model
                break
                ;;
        esac
    done
}




