apply_patch() {
    local patch_file="$1"
    if [ ! -f "$patch_file" ]; then
        echo "Error: Patch file '$patch_file' not found."
        exit 1
    fi
    echo "[Patch] Applying $patch_file..."
    
    cd "$LLAMA_DIR" || exit 1
    patch -p0 --forward < "$patch_file" || patch --forward < "$patch_file"
    
    echo -e "\n${c_green}Patch applied successfully.${c_reset}"
    echo "You can now run './llm_perf -c' to recompile the active backend."
    exit 0
}

run_deepseek_standalone() {
    local remote_host="$1"
    local base_url
    if [ -n "$remote_host" ]; then
        if [[ "$remote_host" == *:* ]]; then
            base_url="http://$remote_host/v1"
        else
            base_url="http://$remote_host:8080/v1"
        fi
        echo "[DeepSeek Harness] Connecting to remote server at $base_url"
    else
        base_url="http://localhost:8080/v1"
    fi

    ensure_repo "$DEEPSEEK_DIR" "$DEEPSEEK_REPO"
    cd "$DEEPSEEK_DIR" || exit
    
    if ! command -v pnpm &> /dev/null; then
        echo "[DeepSeek Harness] Error: pnpm is required but not installed."
        echo "Please install it using 'npm install -g pnpm'"
        exit 1
    fi
    
    echo "Setting up DeepSeek Harness Node environment..."
    pnpm install
    pnpm run build
    
    export BASE_URL="$base_url"
    export SELECTED_ALIAS="${selected_alias:-llama-local}"
    
    mkdir -p "$HOME/.dsh"
    
    node -e '
    const fs = require("fs");
    const yaml = require("js-yaml");
    const path = require("path");
    const settingsPath = path.join(process.env.HOME, ".dsh", "settings.yaml");
    const baseUrl = process.env.BASE_URL;
    const modelId = process.env.SELECTED_ALIAS;
    
    let settings = {};
    try {
        if (fs.existsSync(settingsPath)) {
            settings = yaml.load(fs.readFileSync(settingsPath, "utf8")) || {};
        }
    } catch (e) {
        console.warn("Notice: Could not parse existing settings.yaml, starting fresh.");
    }
    
    settings["llm-pi-ai"] = settings["llm-pi-ai"] || {};
    settings["llm-pi-ai"].providers = settings["llm-pi-ai"].providers || {};
    settings["llm-pi-ai"].providers["llama-local"] = {
        api: "openai-completions",
        baseURL: baseUrl,
        apiKeyEnv: "DUMMY_API_KEY",
        models: [{ id: modelId }]
    };
    
    fs.writeFileSync(settingsPath, yaml.dump(settings));
    '
    
    echo "[DeepSeek Harness] Auto-added model ${selected_alias:-llama-local} at $base_url"
    export DUMMY_API_KEY="${API_KEY:-dummy}"
    
    echo "[DeepSeek Harness] Starting Web UI on http://127.0.0.1:3080..."
    pnpm dsh web
}

