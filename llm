#!/bin/bash
# =============================================================================
# llm - A management script for llama.cpp
# =============================================================================

SCRIPT_PATH="$(readlink -f "$BASH_SOURCE")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# Main installation directory
BASE_DIR="${MYKYSW_DIR:-$HOME/mykysw}"

# Lists / Config Directory
CONFIG_DIR="$BASE_DIR/config"
mkdir -p "$CONFIG_DIR"
ACTIVE_BACKEND_FILE="$CONFIG_DIR/active_backend.txt"
if [ -f "$ACTIVE_BACKEND_FILE" ]; then
    ACTIVE_BACKEND=$(cat "$ACTIVE_BACKEND_FILE")
else
    ACTIVE_BACKEND="mainline"
fi

# Base directories
LLAMA_DIR="$BASE_DIR/llama.cpp-$ACTIVE_BACKEND"
modelstorage="$BASE_DIR/modelstorage"
PROMPTS_DIR="$BASE_DIR/prompts"

# UI Repositories
SILLYTAVERN_DIR="$BASE_DIR/sillytavern"
SILLYTAVERN_REPO="https://github.com/SillyTavern/SillyTavern.git"
DEEPSEEK_DIR="$BASE_DIR/deepseek-harness"
DEEPSEEK_REPO="https://github.com/deepseek-ai/deepseek-harness.git"
OOBABOOGA_DIR="$BASE_DIR/text-generation-webui"
OOBABOOGA_REPO="https://github.com/oobabooga/text-generation-webui.git"
ODYSSEUS_DIR="$BASE_DIR/odysseus"
ODYSSEUS_REPO="https://github.com/pewdiepie-archdaemon/odysseus.git"
HERMES_DIR="$BASE_DIR/hermes"
HERMES_REPO="https://github.com/NousResearch/hermes-agent.git"
PI_DIR="$BASE_DIR/pi"
LITTLECODER_DIR="$BASE_DIR/little-coder"
if [ -f "$SCRIPT_DIR/index.ts" ] && [ -d "$SCRIPT_DIR/bin" ]; then
    MYKYAGENT_DIR="$SCRIPT_DIR"
else
    MYKYAGENT_DIR="${MYKYAGENT_DIR:-$BASE_DIR/mykyagent}"
fi
OPENCODE_DIR="$BASE_DIR/opencode"
CODEHAMR_DIR="$BASE_DIR/codehamr"

# System Resources
if command -v lscpu &> /dev/null; then
    PHYSICAL_CORES=$(lscpu -b -p=Core,Socket | grep -v '^#' | sort -u | wc -l)
else
    PHYSICAL_CORES=$(nproc 2>/dev/null || echo 4)
fi
BUILD_THREADS=$(nproc 2>/dev/null || echo "$PHYSICAL_CORES")  # all logical cores for compilation
export BLIS_NUM_THREADS=$PHYSICAL_CORES
export OMP_NUM_THREADS=$PHYSICAL_CORES

# Configuration
EDITOR=kate
SUDO=sudo
API_KEY="cannotguess"
CMAKE_COMPILER_ARGS=()
BUILDOPT=()

FORCE_RESET=0
for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" ]]; then
        FORCE_RESET=1
    fi
done

# Optimized defaults with dynamic speculative decoding cache
mkdir -p "$BASE_DIR/cache"

SETTINGS_FILE="$CONFIG_DIR/llm_settings.conf"
if [ -f "$SETTINGS_FILE" ]; then
    source "$SETTINGS_FILE"
else
    S_TEMP="0.6"
    S_TOP_P="0.95"
    S_TOP_K="20"
    S_MIN_P="0.0"
    S_TFS="1.0"
    S_TYPICAL="1.0"
    S_MIROSTAT="0"
    S_MIROSTAT_LR="0.1"
    S_MIROSTAT_ENT="5.0"
    S_PRESENCE="0.0"
    S_FREQUENCY="0.0"
    S_PENALTY_REPEAT="1.0"
    S_PENALTY_LAST_N="64"
    S_SPEC_TYPE="none"
    S_SPEC_N_MAX="0"
    S_SPEC_N_MIN="0"
    S_SPEC_DM="off"
    S_CTX_SIZE="0"
    S_DRAFT_MODEL=""
    
    cat > "$SETTINGS_FILE" <<EOF
S_TEMP="$S_TEMP"
S_TOP_P="$S_TOP_P"
S_TOP_K="$S_TOP_K"
S_MIN_P="$S_MIN_P"
S_TFS="$S_TFS"
S_TYPICAL="$S_TYPICAL"
S_MIROSTAT="$S_MIROSTAT"
S_MIROSTAT_LR="$S_MIROSTAT_LR"
S_MIROSTAT_ENT="$S_MIROSTAT_ENT"
S_PRESENCE="$S_PRESENCE"
S_FREQUENCY="$S_FREQUENCY"
S_PENALTY_REPEAT="$S_PENALTY_REPEAT"
S_PENALTY_LAST_N="$S_PENALTY_LAST_N"
S_SPEC_TYPE="$S_SPEC_TYPE"
S_SPEC_N_MAX="$S_SPEC_N_MAX"
S_SPEC_N_MIN="$S_SPEC_N_MIN"
S_SPEC_DM="$S_SPEC_DM"
S_CTX_SIZE="$S_CTX_SIZE"
S_DRAFT_MODEL="$S_DRAFT_MODEL"
EOF
fi

if [ "$S_MIROSTAT" != "0" ]; then
    LLM_DEFAULTS="--temp 1.0 "
else
    LLM_DEFAULTS="--temp $S_TEMP "
fi
LLM_DEFAULTS+="--top-p $S_TOP_P --top-k $S_TOP_K --min-p $S_MIN_P "
LLM_DEFAULTS+="--typical $S_TYPICAL --mirostat $S_MIROSTAT --mirostat-lr $S_MIROSTAT_LR --mirostat-ent $S_MIROSTAT_ENT "
LLM_DEFAULTS+="--presence-penalty $S_PRESENCE --frequency-penalty $S_FREQUENCY --repeat-penalty $S_PENALTY_REPEAT --repeat-last-n $S_PENALTY_LAST_N "
[ "$S_SPEC_TYPE" != "none" ] && LLM_DEFAULTS+="--spec-type $S_SPEC_TYPE "
[ "$S_SPEC_N_MAX" != "0" ] && LLM_DEFAULTS+="--spec-draft-n-max $S_SPEC_N_MAX --spec-draft-n-min $S_SPEC_N_MIN "
[ "$S_SPEC_DM" != "off" ] && LLM_DEFAULTS+="--spec-dm-controller $S_SPEC_DM "
if [ "$S_CTX_SIZE" != "0" ] && [ -n "$S_CTX_SIZE" ]; then
    LLM_DEFAULTS+="-c $S_CTX_SIZE "
fi
if [ -n "$S_DRAFT_MODEL" ] && [ "$S_DRAFT_MODEL" != '""' ]; then
    LLM_DEFAULTS+="-md $S_DRAFT_MODEL "
fi


case "$ACTIVE_BACKEND" in
    ikllamacpp)
        LLAMA_REPO="https://github.com/ikawrakow/ik_llama.cpp.git"
        # ikllamacpp is highly optimized for CPU inference with its own FlashMLA implementation.
        # --device none: ikllamacpp Vulkan lacks the large-tensor fallback that mainline/beellama have;
        # output.weight is 1940 MiB which always exceeds Vulkan's 1GB buffer limit and hard-crashes.
        DEFAULT_MODEL_ARGS="-rtr --no-warmup -fa on -ctk q8_0 -ctv q8_0 --device none -t $PHYSICAL_CORES -tb $PHYSICAL_CORES -ub 1024 $LLM_DEFAULTS"
        ;;
    beellamacpp)
        LLAMA_REPO="https://github.com/Anbeeld/beellama.cpp.git"
        # beellamacpp-specific extras:
        #   --reasoning-loop-guard : auto force-closes infinite thinking loops on reasoning models
        #   -ub 2048               : beellama handles larger ubatch well, helps PP throughput
        DEFAULT_MODEL_ARGS="--poll 0 --no-warmup -fa on -ctk q8_0 -ctv q8_0 --reasoning-loop-guard force-close -t $PHYSICAL_CORES -tb $PHYSICAL_CORES --cpu-strict 1 -ub 2048 $LLM_DEFAULTS"
        ;;
    *)
        LLAMA_REPO="https://github.com/ggerganov/llama.cpp.git"
        # Mainline llama.cpp defaults.
        DEFAULT_MODEL_ARGS="--poll 0 --no-warmup -fa on -ctk q8_0 -ctv q8_0 -t $PHYSICAL_CORES -tb $PHYSICAL_CORES --cpu-strict 1 -ub 1024 $LLM_DEFAULTS"
        ;;
esac

# Server-mode extra flags (applied on top of defaults for server modes)
SERVER_ARGS="--slot-save-path $BASE_DIR/cache --jinja"

# Lists / Config Directory
CONFIG_DIR="$BASE_DIR/config"
mkdir -p "$CONFIG_DIR"
MODEL_LIST_FILE="$CONFIG_DIR/llm_models.txt"
PROMPT_LIST_FILE="$CONFIG_DIR/llm_prompts.txt"

# Migrate old lists if they exist
[ -f "$BASE_DIR/.llm_models" ] && mv "$BASE_DIR/.llm_models" "$MODEL_LIST_FILE"
[ -f "$BASE_DIR/.llm_prompts" ] && mv "$BASE_DIR/.llm_prompts" "$PROMPT_LIST_FILE"

export FZF_DEFAULT_OPTS="--color=dark,bg+:-1,fg:gray,fg+:white,prompt:blue,pointer:red,marker:yellow"

# Auto-Offload VRAM Limit (in Megabytes). Set to 0 to disable.
MAX_VRAM_MB="0"

# Base compiler flags (-O3 already comes from CMAKE_BUILD_TYPE=Release)
# -fno-plt             : skip PLT trampolines (faster shared-lib calls)
# -fipa-pta            : inter-procedural points-to analysis (GCC-only)
# -fno-stack-protector : drop stack canary overhead (inference server, no user input)
# -funroll-loops       : unroll hot loops (helps GGML kernels)
BASE_CFLAGS="-fno-plt -fipa-pta -fno-stack-protector -funroll-loops"
LLAMA_CFLAGS=""

# =============================================================================
# Helper Functions
# =============================================================================

run_cmake() {
    if ! cmake "$@"; then
        echo -e "\n[CMake] Configuration failed! This often happens if the project directory was moved."
        echo "[CMake] Cleaning CMake cache and retrying..."
        rm -rf build/CMakeCache.txt build/CMakeFiles
        cmake "$@"
    fi
}

fzf_with_usage() {
    local menu_id="$1"
    shift
    local usage_file="$CONFIG_DIR/usage_${menu_id}.txt"
    
    local tmp_input=$(mktemp)
    cat > "$tmp_input"
    
    local selected=$(
        if [ -f "$usage_file" ]; then
            awk -F'\t' '
                NR==FNR { usage[$2] = $1; next }
                {
                    key = $0
                    sub(/^[ \t]*[0-9]+\)[ \t]+/, "", key)
                    count = (key in usage) ? usage[key] : 0
                    print count "\t" FNR "\t" $0
                }
            ' "$usage_file" "$tmp_input" | sort -k1,1nr -k2,2n | cut -f3-
        else
            cat "$tmp_input"
        fi | fzf "$@"
    )
    
    rm -f "$tmp_input"
    
    if [ -n "$selected" ]; then
        local key="$selected"
        key=$(echo "$key" | sed -E 's/^[ \t]*[0-9]+\)[ \t]+//')
        
        export KEY="$key"
        if [ -f "$usage_file" ]; then
            awk -F'\t' '
                BEGIN { k = ENVIRON["KEY"] }
                $2 == k { print ($1 + 1) "\t" $2; found=1; next }
                { print $0 }
                END { if (!found) print "1\t" k }
            ' "$usage_file" > "${usage_file}.tmp" && mv "${usage_file}.tmp" "$usage_file"
        else
            echo -e "1\t$key" > "$usage_file"
        fi
        echo "$selected"
    fi
}

